generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  editable    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // bcrypt hash
  fullName  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales            Sale[]
  cancelledSales   Sale[]          @relation("CancelledSale")
  quotations       Quotation[]
  openedRegisters  CashRegister[]  @relation("OpenedRegister")
  closedRegisters  CashRegister[]  @relation("ClosedRegister")
  movements        CashMovement[]
  rateChanges      UsdRate[]
  invoiceDocuments InvoiceDocument[]
}

model Permission {
  id          String   @id @default(uuid())
  handler     String   @unique
  description String?
  category    String   @default("general")

  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─── Customers (RIF / datos fiscales) ────────────────────────

model Customer {
  id           String   @id @default(uuid())
  taxId        String   @unique // RIF, NIT, RFC, RUC
  name         String
  personType   String   @default("V") // V=Natural Venezolano, E=Natural Extranjero, J=Jurídico, G=Gobierno
  personSubtype String  @default("contribuyente") // contribuyente, no_contribuyente, especial, independiente, dependiente
  legalType    String?  // CA, SRL, SC, FUNDACION (solo para Jurídicas)
  address      String?
  phone        String?
  email        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales     Sale[]
  quotations Quotation[]
}

// ─── Products & Inventory ────────────────────────────────────

enum ProductType {
  PRODUCT       // Producto físico con inventario
  SERVICE       // Servicio sin control de inventario
  COMBO         // Paquete de productos/servicios
}

model Product {
  id          String      @id @default(uuid())
  code        String      @unique // SKU / código de barras
  name        String
  description String?
  type        ProductType @default(PRODUCT)
  price       Float       @default(0) // Precio calculado en moneda local (priceUsd * tasa del día)
  priceUsd    Float       // Precio referencial en USD (valor primario)
  cost        Float?      // Costo (para margen de ganancia)
  stock       Int         @default(0)
  image       String?     // Ruta de imagen del producto
  active      Boolean     @default(true)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  saleItems        SaleItem[]
  quotationItems   QuotationItem[]
  taxes            ProductTax[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  color    String?   // Para badges y organización visual
  products Product[]
}

// ─── Taxes (impuestos configurables) ──────────────────────────

model Tax {
  id          String       @id @default(uuid())
  name        String       @unique // Ej: "IVA 16%", "IVA Reducido 8%"
  rate        Float        // Porcentaje, ej: 16.0
  description String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products    ProductTax[]
}

model ProductTax {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxId     String
  tax       Tax     @relation(fields: [taxId], references: [id], onDelete: Cascade)

  @@id([productId, taxId])
}

// ─── Sales & Transactions ────────────────────────────────────

enum SaleStatus {
  ACTIVE        // En curso (carrito abierto)
  COMPLETED     // Cobrada exitosamente
  CANCELLED     // Anulada
  REFUNDED      // Reembolsada
}

enum DocumentType {
  FACTURA       // Factura fiscal — requiere cliente
  TICKET        // Ticket consumidor final — sin datos de cliente
  PRESUPUESTO   // Presupuesto / cotización — no afecta stock ni reportes
}

enum QuotationStatus {
  DRAFT         // Borrador
  SENT          // Enviado al cliente
  CONVERTED     // Convertido a factura
  EXPIRED       // Vencido
  CANCELLED     // Anulado
}

enum PaymentMethod {
  CASH          // Efectivo
  TRANSFER      // Transferencia/Pago Móvil
  DEBIT_CARD    // Débito
  CREDIT_CARD   // Crédito
  DIVISA        // Divisas (USD, EUR)
  MIXED         // Mixto
}

model Sale {
  id              String       @id @default(uuid())
  receiptNumber   Int          @unique // Número de factura correlativo
  documentType    DocumentType @default(TICKET)
  status          SaleStatus   @default(ACTIVE)
  subtotal        Float        // Suma de items sin IVA
  taxTotal        Float        // Suma de IVA
  discount        Float        @default(0)
  total           Float        // Monto final
  usdRate         Float?       // Tasa del dólar al momento de la venta
  notes           String?
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  createdAt       DateTime     @default(now())
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledBy     User?        @relation("CancelledSale", fields: [cancelledById], references: [id])
  cashRegisterId  String?
  cashRegister    CashRegister? @relation(fields: [cashRegisterId], references: [id])

  items SaleItem[]
  payments PaymentEntry[]
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  invoiceDocument InvoiceDocument?
}

model SaleItem {
  id           String  @id @default(uuid())
  quantity     Int
  price        Float   // Precio unitario en moneda local al momento de la venta
  priceUsd     Float?  // Precio unitario en USD al momento de la venta
  discount     Float   @default(0) // Descuento por línea en USD
  subtotal     Float   // (quantity * price) - discount
  taxRate      Float   @default(16.0) // Tasa combinada de impuestos
  taxAmount    Float   // Suma total de impuestos
  taxBreakdown String? // JSON con desglose: [{"taxId":"...","name":"IVA 16%","rate":16,"amount":1.28}]
  total        Float   // subtotal + taxAmount
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  saleId       String
  sale         Sale    @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model PaymentEntry {
  id        String  @id @default(uuid())
  method    String  // CASH, TRANSFER, DEBIT_CARD, CREDIT_CARD, DIVISA
  amountBs  Float   // Monto en bolívares
  reference String? // Número de autorización / referencia
  bank      String? // Banco de origen (VE: Banesco, Mercantil, Provincial, etc.)
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ─── Quotations (Presupuestos) ───────────────────────────────
// Presupuestos no afectan stock, caja, ni reportes de ventas.
// Son cotizaciones que pueden convertirse en una factura (Sale).

model Quotation {
  id              String          @id @default(uuid())
  number          Int             @unique // Correlativo independiente
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime        // Fecha de vencimiento del presupuesto
  subtotal        Float
  taxTotal        Float
  discount        Float           @default(0)
  total           Float
  usdRate         Float?          // Tasa del dólar al momento de crear el presupuesto
  notes           String?
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  convertedToSaleId String?       // Si se convirtió, link a la factura generada
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           QuotationItem[]

  @@index([status])
  @@index([customerId])
}

model QuotationItem {
  id           String  @id @default(uuid())
  quantity     Int
  priceUsd     Float?  // Precio unitario en USD al momento del presupuesto
  discount     Float   @default(0) // Descuento por línea en USD
  subtotal     Float   // (quantity * price) - discount
  taxRate      Float   @default(16.0)
  taxAmount    Float
  taxBreakdown String? // JSON con desglose: [{"name":"IVA 16%","rate":16,"amount":1.28}]
  total        Float   // subtotal + taxAmount
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// ─── Shift Config (Configuración de Turnos) ──────────────────
// Define turnos nominales: nombre, días de la semana, horario.

model ShiftConfig {
  id        String   @id @default(uuid())
  name      String   // "Turno Mañana", "Turno Tarde", etc.
  days      String   // JSON array de números: "[1,2,3,4,5]" (1=lun, 7=dom)
  startTime String   // "08:00"
  endTime   String   // "14:00"
  order     Int      @default(0)  // Orden de visualización
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registers CashRegister[]
}

// ─── Cash Register (Arqueo de Caja) ──────────────────────────

enum CashMovementType {
  OPENING       // Apertura de caja
  INCOME       // Ingreso extra
  EXPENSE      // Gasto
  WITHDRAWAL   // Retiro
  CLOSING      // Cierre de caja
}

model CashRegister {
  id             String   @id @default(uuid())
  openedAt       DateTime           // Fecha/hora de apertura (ingresada por el usuario)
  openingBalance Float    @default(0)
  closingBalance Float?
  closedAt       DateTime?          // Fecha/hora de cierre (ingresada por el usuario)
  closedById     String?
  closedBy       User?    @relation("ClosedRegister", fields: [closedById], references: [id])
  openedById     String?
  openedBy       User?    @relation("OpenedRegister", fields: [openedById], references: [id])
  shiftConfigId  String?
  shiftConfig    ShiftConfig? @relation(fields: [shiftConfigId], references: [id])

  movements CashMovement[]
  sales     Sale[]

  @@index([openedById])
  @@index([shiftConfigId])
}

model CashMovement {
  id          String            @id @default(uuid())
  type        CashMovementType
  amount      Float
  description String?
  reference   String?           // Número de referencia si aplica
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  registerId  String
  register    CashRegister      @relation(fields: [registerId], references: [id])
  saleId      String?
  createdAt   DateTime          @default(now())

  @@index([registerId])
}

// ─── Company Configuration ───────────────────────────────────

model CompanyConfig {
  id           String   @id @default("default")
  businessName String
  taxId        String?
  address      String?
  phone        String?
  email        String?
  logo         String?  // Ruta de archivo de imagen
  updatedAt    DateTime @updatedAt
}

// ─── Fiscal & Configuration ──────────────────────────────────

model FiscalConfig {
  id               String   @id @default("default")
  printerType      String   // "bixolon", "epson", "sharp", "sam4s"
  printerPort      String   // Puerto COM, USB, etc.
  printerEnabled   Boolean  @default(false)
  seniatEnabled    Boolean  @default(false)
  autoSendSeniat   Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model AppConfig {
  id                String  @id @default("default")
  country           String  @default("VE")
  currencySymbol    String  @default("Bs.")
  usdRate           Float   @default(0)
  usdRateSource     String  @default("bcv")
  usdRateId         String?
  usdAutoUpdate     Boolean @default(false)
  receiptFooter     String?
  taxRateDefault    Float   @default(16.0)
  lowStockThreshold Int     @default(10)
  darkMode          Boolean @default(false)
  inactivityTimeout     Int     @default(600)
  quotationValidityDays Int     @default(30)
  updatedAt             DateTime @updatedAt
}

// ─── USD Rate History ───────────────────────────────────────

model UsdRate {
  id          String   @id @default(uuid())
  rate        Float
  source      String   @default("manual")
  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// ─── Invoice Document (Factura Congelada) ───────────────────
// Copia inalterable de cada factura emitida. Los campos de moneda
// y región son dinámicos según el country plugin activo.
// El snapshot JSON contiene todo el detalle: items, pagos, impuestos.
// El pluginSnapshot contiene datos específicos del país (SENIAT, DIAN, etc.)

model InvoiceDocument {
  id              String   @id @default(uuid())
  saleId          String   @unique
  sale            Sale     @relation(fields: [saleId], references: [id])

  // ─── Identificación ────────────────────────────────────────
  documentType    String                     // FACTURA | TICKET | PRESUPUESTO
  receiptNumber   Int
  series          String?                    // Prefijo: "F-", "A-", "001-001-"
  issuedAt        DateTime                   // Fecha de emisión
  dueDate         DateTime?                  // Vencimiento (crédito)

  // ─── Origen (caja / sucursal) ──────────────────────────────
  posCode         String?                    // "CAJA-01"
  branchCode      String?                    // "MATRIZ", "SUC-01"
  terminalId      String?                    // Hostname / machineId

  // ─── Operativo ─────────────────────────────────────────────
  shiftId         String?
  shiftName       String?                    // Congelado: "Mañana"
  sellerId        String?
  sellerName      String?                    // Congelado
  orderRef        String?                    // Pedido externo

  // ─── Cliente (congelado) ───────────────────────────────────
  customerName        String?
  customerTaxId       String?
  customerPersonType  String?     // V, E, J, G, P (del RIF)
  customerPersonSubtype String?   // contribuyente, no_contribuyente, especial
  customerAddress     String?
  customerPhone       String?
  customerEmail       String?

  // ─── Monetario (dinámico por plugin) ───────────────────────
  currencyCode    String   @default("VES")
  currencySymbol  String   @default("Bs.")
  exchangeRate    Float?
  exchangeSource  String?                    // "bcv", "trm", "paralelo"
  subtotal        Float
  discount        Float    @default(0)
  taxTotal        Float
  total           Float
  totalUsd        Float?

  // ─── Impuestos desglosados ─────────────────────────────────
  taxBreakdown    String?                    // JSON

  // ─── Snapshots (JSON) ──────────────────────────────────────
  itemsSnapshot   String                     // JSON array — productos
  paymentsSnapshot String                    // JSON array — pagos

  // ─── Texto libre ───────────────────────────────────────────
  motivo          String?
  notes           String?
  customerNotes   String?

  // ─── Plugin data (country plugin activo) ───────────────────
  pluginId        String?                    // "plugin-ve", "plugin-co"
  pluginSnapshot  String?                    // JSON con datos específicos

  // ─── Formatos exportados ───────────────────────────────────
  pdfPath         String?
  xmlContent      String?
  externalStatus  String?                    // null | "sent" | "accepted" | "rejected"
  externalId      String?                    // CUFE, CAE, UUID SAT

  // ─── Trazabilidad ──────────────────────────────────────────
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([saleId])
  @@index([receiptNumber])
  @@index([issuedAt])
  @@index([customerTaxId])
  @@index([posCode])
  @@index([shiftId])
}
